{
  "check_interval": {
    "type": "int",
    "default": 60,
    "description": "检查间隔时间（秒）",
    "hint": "最小值 10 秒，过短会频繁请求上游 API"
  },
  "notify_targets": {
    "type": "list",
    "default": [],
    "description": "接收状态变化通知的会话列表（unified_msg_origin）",
    "hint": "填入需要接收服务状态通知的会话 ID。可以通过发送 /sid 指令获取当前会话的 unified_msg_origin"
  },
  "service_groups": {
    "description": "服务监控开关",
    "type": "object",
    "items": {
      "china_services": {
        "description": "国内服务",
        "type": "object",
        "items": {
          "enable_moonshot": {
            "type": "bool",
            "default": false,
            "description": "Moonshot AI (Kimi)"
          },
          "enable_deepseek_api": {
            "type": "bool",
            "default": false,
            "description": "DeepSeek API（HTTP 探测）"
          },
          "enable_zhipu": {
            "type": "bool",
            "default": false,
            "description": "智谱AI开放平台（HTTP 探测）"
